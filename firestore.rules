rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    function professor() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.role == 'professor';
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || professor());

      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.role == 'aluno';

      allow update: if logado() && (
        (request.auth.uid == uid
          && resource.data.role == 'aluno'
          && request.resource.data.role == 'aluno')
        || professor()
      );

      allow delete: if professor();

      match /curriculos/{curriculoId} {
        allow read, write: if logado() && (request.auth.uid == uid || professor());
      }
    }

    match /submissoes/{submissaoId} {
      allow read: if logado() && (resource.data.alunoUid == request.auth.uid || professor());

      allow create: if logado()
        && request.resource.data.alunoUid == request.auth.uid;

      allow update: if logado()
        && resource.data.alunoUid == request.auth.uid
        && request.resource.data.alunoUid == request.auth.uid;

      allow delete: if logado() && (resource.data.alunoUid == request.auth.uid || professor());
    }

    match /avaliacoes/{avaliacaoId} {
      allow read: if logado() && (resource.data.alunoUid == request.auth.uid || professor());
      allow create, update, delete: if professor();
    }
  }
}
