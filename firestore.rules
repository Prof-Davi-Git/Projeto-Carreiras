rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logado() {
      return request.auth != null;
    }

    function perfilAtual() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function professor() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilAtual().data.role == 'professor';
    }

    function aluno() {
      return logado()
        && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid))
        && perfilAtual().data.role == 'aluno';
    }

    function vagaExiste(vagaId) {
      return vagaId is string
        && exists(/databases/$(database)/documents/vagas/$(vagaId));
    }

    function vagaDoProfessor(vagaId) {
      return professor()
        && vagaExiste(vagaId)
        && get(/databases/$(database)/documents/vagas/$(vagaId)).data.professorUid == request.auth.uid;
    }

    function vagaDaTurmaDoAluno(vagaId) {
      return aluno()
        && vagaExiste(vagaId)
        && perfilAtual().data.turmaId != null
        && get(/databases/$(database)/documents/vagas/$(vagaId)).data.turmaId == perfilAtual().data.turmaId;
    }

    match /usuarios/{uid} {
      allow read: if logado() && (request.auth.uid == uid || professor());

      allow create: if logado()
        && request.auth.uid == uid
        && request.resource.data.role == 'aluno';

      allow update: if logado() && (
        (request.auth.uid == uid
          && resource.data.role == 'aluno'
          && request.resource.data.role == 'aluno'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'ultimoAcessoEm',
            'escolaId',
            'escolaNome',
            'turmaId',
            'turmaNome'
          ]))
        || professor()
      );

      allow delete: if professor();

      match /curriculos/{curriculoId} {
        allow read, write: if logado() && (request.auth.uid == uid || professor());
      }
    }

    match /vagas/{vagaId} {
      allow read: if logado() && (
        (professor() && resource.data.professorUid == request.auth.uid)
        || (aluno()
          && perfilAtual().data.turmaId != null
          && resource.data.turmaId == perfilAtual().data.turmaId)
      );

      allow create: if professor()
        && request.resource.data.professorUid == request.auth.uid
        && request.resource.data.turmaId is string
        && request.resource.data.titulo is string;

      allow update: if professor()
        && resource.data.professorUid == request.auth.uid
        && request.resource.data.professorUid == request.auth.uid;

      allow delete: if professor()
        && resource.data.professorUid == request.auth.uid;
    }

    match /submissoes/{submissaoId} {
      allow read: if logado() && (
        resource.data.alunoUid == request.auth.uid
        || vagaDoProfessor(resource.data.vagaId)
      );

      allow create: if aluno()
        && request.resource.data.alunoUid == request.auth.uid
        && vagaDaTurmaDoAluno(request.resource.data.vagaId);

      allow update: if aluno()
        && resource.data.alunoUid == request.auth.uid
        && request.resource.data.alunoUid == request.auth.uid
        && request.resource.data.vagaId == resource.data.vagaId
        && vagaDaTurmaDoAluno(request.resource.data.vagaId);

      allow delete: if aluno()
        && resource.data.alunoUid == request.auth.uid;
    }

    match /avaliacoes/{avaliacaoId} {
      allow read: if logado() && (
        resource.data.alunoUid == request.auth.uid
        || vagaDoProfessor(resource.data.vagaId)
      );

      allow create: if vagaDoProfessor(request.resource.data.vagaId)
        && request.resource.data.professorUid == request.auth.uid;

      allow update: if vagaDoProfessor(resource.data.vagaId)
        && request.resource.data.vagaId == resource.data.vagaId
        && request.resource.data.professorUid == request.auth.uid;

      allow delete: if vagaDoProfessor(resource.data.vagaId);
    }
  }
}
